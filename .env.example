# Environment Variables Template
# Co-Pilot SE - Multi-Cloud POC
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# =============================================================================
# AZURE OPENAI
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5  # or gpt-4-turbo as fallback
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =============================================================================
# BING SEARCH API
# =============================================================================
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
BING_SEARCH_API_KEY=your-bing-search-api-key-here
BING_SEARCH_TIER=S1
BING_SEARCH_RATE_LIMIT=10  # queries per second

# =============================================================================
# YOUTUBE DATA API
# =============================================================================
YOUTUBE_API_KEY=your-youtube-data-api-key-here

# =============================================================================
# AZURE AD AUTHENTICATION
# =============================================================================
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_SUBSCRIPTION_ID=your-subscription-id

# =============================================================================
# AZURE FUNCTIONS
# =============================================================================
AZURE_FUNCTIONS_WORKER_RUNTIME=python
AZURE_FUNCTIONS_WORKER_PYTHON_VERSION=3.11

# =============================================================================
# APPLICATION INSIGHTS
# =============================================================================
APPINSIGHTS_INSTRUMENTATION_KEY=your-appinsights-key
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://swedencentral-1.in.applicationinsights.azure.com/

# =============================================================================
# AZURE KEY VAULT (Optional)
# =============================================================================
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
CACHE_TTL=3600  # seconds

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
API_PORT=7071
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
MAX_RETRIES=3
TIMEOUT_SECONDS=180
ENABLE_CHAIN_OF_THOUGHT=true

# =============================================================================
# DATA SOURCES CONFIGURATION
# =============================================================================
BING_SEARCH_CACHE_ENABLED=true
BING_SEARCH_CACHE_TTL=3600
YOUTUBE_TRANSCRIPT_CACHE_ENABLED=true
YOUTUBE_TRANSCRIPT_CACHE_TTL=86400  # 24 hours

# =============================================================================
# COST ESTIMATION
# =============================================================================
COST_ESTIMATION_ACCURACY_TARGET=0.30  # ±30% for POC
COST_DISCLAIMER_ENABLED=true

# =============================================================================
# MCP SERVER (Optional - for GitHub Copilot Chat)
# =============================================================================
MCP_SERVER_PORT=3001
MCP_SERVER_HOST=localhost
MCP_AUTH_ENABLED=true

# =============================================================================
# TRUSTED SOURCES CONFIGURATION
# =============================================================================
TRUSTED_SOURCES_CONFIG_PATH=./config/trusted_sources.yaml
MULTI_CLOUD_SERVICE_MAPPING_PATH=./config/service_mapping.yaml

# =============================================================================
# FEATURE FLAGS (POC)
# =============================================================================
ENABLE_COMPLIANCE_AGENT=false  # Disabled for POC
ENABLE_RAG=false  # Online-only for POC
ENABLE_DOCUMENT_UPLOAD=false  # Not in POC scope
ENABLE_MCP_INTEGRATION=true
ENABLE_TEAMS_BOT=false  # Deferred to Phase 6
