# Environment Variables Template
# Co-Pilot SE - Multi-Cloud POC
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# =============================================================================
# AZURE OPENAI
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5  # or gpt-4-turbo as fallback
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =============================================================================
# AZURE AI FOUNDRY PROJECT (Required for Azure AI Agent Service)
# =============================================================================
# Get this from Azure AI Foundry Portal:
# 1. Go to https://ai.azure.com
# 2. Navigate to your project
# 3. Settings > Project details > Copy "Project endpoint"
# Format: https://<name>.services.ai.azure.com/api/projects/<project-id>
AZURE_AI_PROJECT=https://your-project.services.ai.azure.com/api/projects/your-project-id

# Model deployment name (used by Azure AI Agents)
MODEL_DEPLOYMENT_NAME=gpt-5

# =============================================================================
# GROUNDING WITH BING SEARCH (via Azure AI Agent Service)
# =============================================================================
# IMPORTANT: Bing Search is now integrated through Azure AI Agent Service!
# Direct Bing Search API is deprecated. You must:
# 1. Create "Grounding with Bing Search" resource in Azure Portal
# 2. Connect it to your AI Foundry project (Connected resources section)
# 3. Copy the Connection ID from Azure AI Foundry Portal
# 
# To get the Connection ID:
# 1. Go to https://ai.azure.com
# 2. Navigate to your project
# 3. Click "Connected resources" in left sidebar
# 4. Find your Bing Grounding connection
# 5. Copy the full Connection ID
# 
# Format: /subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>/connections/<connection-name>
BING_CONNECTION_ID=/subscriptions/your-subscription-id/resourceGroups/your-rg/providers/Microsoft.CognitiveServices/accounts/your-account/projects/your-project/connections/bing-grounding-connection

# Legacy Bing Search API (DEPRECATED - not used with Azure AI Agent Service)
# BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
# BING_SEARCH_API_KEY=your-bing-key

# =============================================================================
# YOUTUBE DATA API
# =============================================================================
YOUTUBE_API_KEY=your-youtube-data-api-key-here

# =============================================================================
# AZURE AD AUTHENTICATION
# =============================================================================
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_SUBSCRIPTION_ID=your-subscription-id

# =============================================================================
# AZURE FUNCTIONS
# =============================================================================
AZURE_FUNCTIONS_WORKER_RUNTIME=python
AZURE_FUNCTIONS_WORKER_PYTHON_VERSION=3.11

# =============================================================================
# APPLICATION INSIGHTS
# =============================================================================
APPINSIGHTS_INSTRUMENTATION_KEY=your-appinsights-key
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://swedencentral-1.in.applicationinsights.azure.com/

# =============================================================================
# AZURE KEY VAULT (Optional)
# =============================================================================
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
CACHE_TTL=3600  # seconds

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
API_PORT=7071
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
MAX_RETRIES=3
TIMEOUT_SECONDS=180
ENABLE_CHAIN_OF_THOUGHT=true

# =============================================================================
# DATA SOURCES CONFIGURATION
# =============================================================================
BING_SEARCH_CACHE_ENABLED=true
BING_SEARCH_CACHE_TTL=3600
YOUTUBE_TRANSCRIPT_CACHE_ENABLED=true
YOUTUBE_TRANSCRIPT_CACHE_TTL=86400  # 24 hours

# =============================================================================
# COST ESTIMATION
# =============================================================================
COST_ESTIMATION_ACCURACY_TARGET=0.30  # ±30% for POC
COST_DISCLAIMER_ENABLED=true

# =============================================================================
# MCP SERVER (Optional - for GitHub Copilot Chat)
# =============================================================================
MCP_SERVER_PORT=3001
MCP_SERVER_HOST=localhost
MCP_AUTH_ENABLED=true

# =============================================================================
# TRUSTED SOURCES CONFIGURATION
# =============================================================================
TRUSTED_SOURCES_CONFIG_PATH=./config/trusted_sources.yaml
MULTI_CLOUD_SERVICE_MAPPING_PATH=./config/service_mapping.yaml

# =============================================================================
# FEATURE FLAGS (POC)
# =============================================================================
ENABLE_COMPLIANCE_AGENT=false  # Disabled for POC
ENABLE_RAG=false  # Online-only for POC
ENABLE_DOCUMENT_UPLOAD=false  # Not in POC scope
ENABLE_MCP_INTEGRATION=true
ENABLE_TEAMS_BOT=false  # Deferred to Phase 6
