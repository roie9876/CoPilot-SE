# Frontend Environment Variables for Azure App Service

# For development (local)
VITE_API_URL=http://localhost:8000

# For Azure App Service - Single App (backend and frontend together)
# VITE_API_URL=https://your-app-name.azurewebsites.net

# For Azure App Service - Separate Backend
# VITE_API_URL=https://your-backend-app.azurewebsites.net

# Build this into the frontend during deployment using Azure build process
